{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mergereceipt:report:v1",
  "title": "MergeReceipt Verification Report",
  "description": "Stable MergeReceipt report contract. Unknown top-level fields are not permitted in schemaVersion 1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "tool",
    "generatedAt",
    "repository",
    "evidence",
    "score",
    "scoreBreakdown",
    "verdict"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "mergereceipt" },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "UTC report generation time. This metadata field is intentionally not deterministic across runs."
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base", "head", "changedFiles"],
      "properties": {
        "base": { "type": "string", "minLength": 1 },
        "head": { "type": "string", "minLength": 1 },
        "changedFiles": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evidence" }
    },
    "score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "scoreBreakdown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["initial", "deductions", "final"],
      "properties": {
        "initial": { "const": 100 },
        "deductions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["evidenceId", "points", "reason"],
            "properties": {
              "evidenceId": { "type": "string", "minLength": 1 },
              "points": { "type": "integer", "minimum": 1 },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        },
        "final": { "type": "integer", "minimum": 0, "maximum": 100 }
      }
    },
    "verdict": {
      "enum": ["PASS", "REVIEW_REQUIRED", "FAIL"]
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "category",
        "status",
        "description",
        "required",
        "deterministic"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "category": {
          "enum": ["command", "repository", "test_signal", "risk", "semantic"]
        },
        "status": {
          "enum": ["passed", "failed", "warning", "skipped"]
        },
        "description": { "type": "string" },
        "required": { "type": "boolean" },
        "deterministic": { "type": "boolean" },
        "details": { "type": "string" },
        "durationMs": { "type": "integer", "minimum": 0 },
        "data": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/jsonValue" }
        }
      }
    },
    "jsonValue": {
      "oneOf": [
        { "type": ["string", "number", "boolean", "null"] },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/jsonValue" }
        },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/jsonValue" }
        }
      ]
    }
  }
}
